clang_use_chrome_plugins=false
dcheck_always_on=false
enable_rust=false
is_clang=true
is_component_build=false
is_debug=false
strip_debug_info=true
symbol_level=0
target_cpu="x64"
target_os="win"
treat_warnings_as_errors=false
# Windows 上必须为 true：clang-cl + MSVC STL 是不受支持且会编译失败的组合（v8-users 有实例，V8 团队成员也表示 MSVC 支持将废弃）
use_custom_libcxx=true
use_rtti=true
use_sysroot=false
v8_deprecation_warnings=false
v8_enable_builtins_optimization=true
v8_enable_gdbjit=false
v8_enable_i18n_support=false
v8_enable_pointer_compression=true
v8_enable_sandbox=false
v8_enable_snapshot_compression=false
v8_enable_temporal_support=false
v8_enable_test_features=false
# 编译期直接移除整个 Wasm 引擎与 WebAssembly.* API（不是靠链接器裁剪）。实测约 9.3MB / 57 个 obj。详见 doc/V8-BUILD-OPTS.md
v8_enable_webassembly=false
v8_imminent_deprecation_warnings=false
v8_monolithic=true
v8_target_cpu="x64"
v8_use_external_startup_data=false
v8_enable_backtrace=false
# cppgc 独立的 caged heap，64 位下默认开，在 V8::Initialize() 时无条件预留 16GB 虚地址；我们从不创建 CppHeap，属纯浪费。详见 doc/V8-BUILD-OPTS.md
cppgc_enable_caged_heap=false
cppgc_enable_pointer_compression=false
# 保持关闭：开启后 PartitionAlloc 的 allocator shim 会与平台 SDK 的 operator new/delete 冲突。沿用"不改原本没打算改的东西"，未在 Windows 上单独复验
v8_enable_partition_alloc=false

# --- 关闭全部调试/诊断能力 ---
# 本仓库只出这一个 args，且刻意不提供 debug 变体：调试 JS 不需要（Inspector 无条件编译，无 v8_enable_inspector 开关）；
# 而 is_debug 在 Windows 上会把 /MT 换成 /MTd，静态库又通过 /DEFAULTLIB 把该选择拖给使用方。详见 doc/ARGS.md §4
# 总闸：真实默认值是 is_debug，这里本已为 false；显式钉住以防翻转 is_debug 或未来 V8 改默认时把整族开关悄悄带回
v8_enable_debugging_features=false
# gni/v8.gni 有 assert(!debugging || verification)，调试关闭时它也必须关；下面多数开关实际由它派生
v8_enable_verification_features=false
# 以下均由上面两开关或 is_debug 派生，本已为 false；显式列出只为让这份配置自成完整一套
v8_enable_v8_checks=false
v8_enable_verify_heap=false
v8_enable_verify_write_barriers=false
v8_enable_verify_csa=false
v8_enable_slow_dchecks=false
v8_enable_debug_code=false
v8_code_comments=false
v8_enable_snapshot_code_comments=false
v8_enable_snapshot_native_code_counters=false
v8_enable_slow_tracing=false
v8_enable_disassembler=false
v8_enable_object_print=false
v8_enable_trace_maps=false
v8_enable_regexp_diagnostics=false
v8_always_enable_maglev_graph_labeller=false
v8_enable_heap_snapshot_verify=false
v8_enable_memory_accounting_checks=false
cppgc_enable_verify_heap=false
# 真实默认值是 1（编进 V8 的 LOG 语句）；0 完全移除，体积和速度双收，代价是拿不到 V8 自身的日志输出
v8_logging_level=0
# 真实默认值是 !build_with_chromium，即独立构建下为 true。纯诊断设施（打印 Maglev 图），无其他依赖
v8_enable_maglev_graph_printer=false
# 真实默认值是 (is_win || is_mac) && !v8_use_perfetto，即此处为 true。运行时双重开关（需本标志 + --enable-system-instrumentation），无稳态开销，只省体积
v8_enable_system_instrumentation=false
# 真实默认值是 is_win，即此处为 true。多编入 7 个 src/diagnostics/etw-*-win.cc 并链 advapi32.lib；同样运行时开关（IsETWTracingEnabled），无稳态开销
v8_enable_etw_stack_walking=false
# 启动提速项：开启指针压缩后本已是派生默认值（static_roots 还 assert 要求指针压缩开启）。按 doc/V8-BUILD-OPTS.md 的建议显式钉住
v8_enable_static_roots=true
v8_enable_short_builtin_calls=true
